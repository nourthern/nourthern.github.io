{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "travel-claims-ics",
  "main": "worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://nourthern.github.io",
    "VAPID_SUBJECT": "https://nourthern.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-claims-reminders",
      "database_id": "245e7146-ec5c-41b3-ba83-9e502298f094"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

